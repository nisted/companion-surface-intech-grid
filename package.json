		"@julusian/midi": "3.8.1"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^22.20.4",
		"eslint": "^10.11.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
